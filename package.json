{
  "name": "build-failure-prosecutor",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Actions 掛掉時，自動產生戲劇化的公訴詞與原創插畫迷因卡，推進 Slack，內含根因假設與建議修法。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check:regex": "tsx scripts/check-safe-regex.ts",
    "check:permissions": "tsx scripts/check-app-permissions.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@octokit/app": "^16.0.1",
    "@octokit/request-error": "^7.0.0",
    "@octokit/rest": "^22.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@slack/web-api": "^7.10.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "pino": "^9.13.1",
    "ulid": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "safe-regex": "^2.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.10"
  }
}
