# 所有 secret 從環境變數注入，絕不進 repo（CLAUDE.md 工程慣例）
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# GitHub App（權限只有 actions:read + metadata:read，見 SPEC.md §5）
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Anthropic（Claude Haiku 4.5）
ANTHROPIC_API_KEY=

# 用於 HMAC 化 Slack user id（SPEC.md §10 feedback.slack_user_hash）
USER_HASH_SECRET=

DATABASE_PATH=./data/prosecutor.sqlite
PUBLIC_BASE_URL=http://localhost:3000
